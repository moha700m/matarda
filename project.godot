; Engine configuration file.
; MATARDA / مطاردة — copyright © Mohammed

config_version=5

[application]

config/name="MATARDA"
config/name_localized={
"ar": "مطاردة"
}
config/description="MATARDA (مطاردة) — original third-person cops versus robbers. Copyright © Mohammed."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.043, 0.071, 0.125, 1)
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Locale="*res://scripts/autoload/locale_service.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
Controls="*res://scripts/autoload/controls.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.043, 0.071, 0.125, 1)
lights_and_shadows/directional_shadow/size=2048

[audio]

driver/output_latency=20

[physics]

common/physics_ticks_per_second=60

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
